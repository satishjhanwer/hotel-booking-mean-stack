{
  "name": "hotel-booking-mean-stack",
  "version": "1.0.0",
  "description": "Full-stack hotel booking application built with MongoDB, Express, Angular, and Node.js.",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd packages/backend && yarn start",
    "start:frontend": "cd packages/frontend && yarn start",
    "seed": "yarn workspace backend seed"
  },
  "keywords": [
    "MongoDB 8",
    "Express 5",
    "Mongoose 9",
    "Angular 22",
    "Tailwind CSS 4",
    "TypeScript 6",
    "Node.js"
  ],
  "author": "Satish Jhanwer",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/satishjhanwer/hotel-booking-mean-stack.git"
  },
  "bugs": {
    "url": "https://github.com/satishjhanwer/hotel-booking-mean-stack/issues"
  },
  "homepage": "https://github.com/satishjhanwer/hotel-booking-mean-stack",
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "resolutions": {
    "http-proxy-middleware": "^3.0.3",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@babel/core@npm:^7.12.3": "npm:7.29.6",
    "minimatch@npm:^3.0.4": "npm:3.1.4",
    "minimatch@npm:^3.1.1": "npm:3.1.4",
    "qs@npm:^6.15.2": "npm:6.16.1",
    "qs@npm:~6.15.1": "npm:6.16.1",
    "ws@npm:~8.17.1": "npm:8.21.1"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
